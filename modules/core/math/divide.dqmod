    "source": "",
    "source_code": "int dq_divide(int a, int b) {\n    if (b == 0) return 0;\n    return a / b;\n}",
    "version": "1.1",
    "metadata": {
        "deltaq.doc.when_to_use": "Когда нужно целочисленное деление двух int-значений.",
        "deltaq.doc.limitations": "Возвращает 0 при делении на ноль и не сообщает об ошибке отдельным каналом."
    }
}
