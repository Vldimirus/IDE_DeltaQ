    "source": "",
    "source_code": "void dq_udp_close(int socket_fd) {\n    if (socket_fd >= 0)\n        close(socket_fd);\n}",
    "version": "1.0",
    "metadata": {
        "deltaq.doc.when_to_use": "Когда graph завершает UDP probe flow и хочет явно закрыть socket fd перед выходом.",
        "deltaq.doc.limitations": "Тонкий Linux-first cleanup helper без richer socket lifecycle semantics."
    }
}
