{
    "category": "io",
    "dependencies": [],
    "description": "Вывод текста",
    "header": "",
    "id": "core.io.print",
    "includes": [
        "stdio.h"
    ],
    "language": "c",
    "name": "print",
    "origin": "core",
    "ports": {
        "input": [
            {
                "kind": "execution",
                "name": "flow_in",
                "type": "exec"
            },
            {
                "name": "text",
                "type": "string"
            }
        ],
        "output": [
            {
                "kind": "execution",
                "name": "flow_out",
                "type": "exec"
            }
        ]
    },
    "source": "",
    "source_code": "void dq_print(const char *text) {\n    printf(\"%s\", text);\n}",
    "version": "1.2",
    "metadata": {
        "deltaq.doc.when_to_use": "Когда нужно вывести строку в stdout без перевода строки внутри console-flow.",
        "deltaq.doc.limitations": "Работает только с текстом и console stdout; не добавляет новую строку."
    }
}
