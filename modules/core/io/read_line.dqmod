    },
    "source": "",
    "source_code": "const char *dq_read_line(void) {\n    static char buf[1024];\n    if (fgets(buf, sizeof(buf), stdin)) {\n        buf[strcspn(buf, \"\\n\")] = '\\0';\n        return buf;\n    }\n    return \"\";\n}",
    "version": "1.2"
}
