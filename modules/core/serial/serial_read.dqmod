{
    "category": "serial",
    "dependencies": [],
    "description": "Чтение текста из serial-порта с timeout",
    "header": "",
    "id": "core.serial.serial_read",
    "includes": [
        "sys/select.h",
        "unistd.h"
    ],
    "language": "c",
    "name": "serial_read",
    "origin": "core",
    "ports": {
        "input": [
            {
                "kind": "execution",
                "name": "flow_in",
                "type": "exec"
            },
            {
                "name": "serial_fd",
                "type": "int"
            },
            {
                "default": "250",
                "name": "timeout_ms",
                "type": "int"
            },
            {
                "default": "256",
                "name": "max_bytes",
                "type": "int"
            }
        ],
        "output": [
            {
                "kind": "execution",
                "name": "flow_out",
                "type": "exec"
            },
            {
                "name": "text",
                "type": "string"
            }
        ]
    },
    "source": "",
    "source_code": "const char *dq_serial_read(int serial_fd, int timeout_ms, int max_bytes) {\n    static char buffer[4096];\n    fd_set read_fds;\n    struct timeval timeout;\n    int ready = 0;\n    size_t limit = sizeof(buffer) - 1U;\n    if (serial_fd < 0)\n        return \"\";\n    if (max_bytes > 0 && (size_t) max_bytes < limit)\n        limit = (size_t) max_bytes;\n    if (timeout_ms < 0)\n        timeout_ms = 0;\n    FD_ZERO(&read_fds);\n    FD_SET(serial_fd, &read_fds);\n    timeout.tv_sec = timeout_ms / 1000;\n    timeout.tv_usec = (timeout_ms % 1000) * 1000;\n    ready = select(serial_fd + 1, &read_fds, NULL, NULL, &timeout);\n    if (ready <= 0)\n        return \"\";\n    ready = (int) read(serial_fd, buffer, limit);\n    if (ready <= 0)\n        return \"\";\n    buffer[ready] = '\\0';\n    return buffer;\n}",
    "version": "1.0",
    "metadata": {
        "deltaq.doc.when_to_use": "Когда graph ждёт небольшой текстовый ответ от serial device bridge/probe flow с явным timeout boundary.",
        "deltaq.doc.limitations": "Блокирует только до заданного timeout, читает один chunk в фиксированный буфер и не даёт richer framing/device metadata."
    }
}
