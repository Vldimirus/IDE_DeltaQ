    "source": "",
    "source_code": "void dq_serial_close(int serial_fd) {\n    if (serial_fd >= 0)\n        close(serial_fd);\n}",
    "version": "1.0",
    "metadata": {
        "deltaq.doc.when_to_use": "Когда graph завершает serial exchange и хочет явно закрыть device fd перед выходом.",
        "deltaq.doc.limitations": "Тонкий Linux-first cleanup helper без richer lifecycle/error-reporting semantics."
    }
}
