{
    "category": "config_json",
    "dependencies": [],
    "description": "Получение string из JSON",
    "header": "",
    "id": "core.config_json.json_get_string",
    "includes": [
        "ctype.h",
        "stdio.h",
        "string.h"
    ],
    "language": "c",
    "name": "json_get_string",
    "origin": "core",
    "ports": {
        "input": [
            {
                "name": "json_text",
                "type": "string"
            },
            {
                "name": "key",
                "type": "string"
            },
            {
                "default": "\"\"",
                "name": "default_value",
                "type": "string"
            }
        ],
        "output": [
            {
                "name": "result",
                "type": "string"
            }
        ]
    },
    "source": "",
    "source_code": "static const char *dq_json_get_string_find_value(const char *json, const char *key) {\n    char pattern[256];\n    const char *cursor = json;\n    if (!json || !key || !*key)\n        return NULL;\n    snprintf(pattern, sizeof(pattern), \"\\\"%s\\\"\", key);\n    while ((cursor = strstr(cursor, pattern)) != NULL) {\n        const char *value = cursor + strlen(pattern);\n        while (*value && isspace((unsigned char) *value))\n            ++value;\n        if (*value == ':')\n            return value + 1;\n        ++cursor;\n    }\n    return NULL;\n}\n\nconst char *dq_json_get_string(const char *json_text, const char *key, const char *default_value) {\n    static char buffer[1024];\n    const char *value = dq_json_get_string_find_value(json_text, key);\n    size_t out = 0;\n    if (!default_value)\n        default_value = \"\";\n    if (!value) {\n        snprintf(buffer, sizeof(buffer), \"%s\", default_value);\n        return buffer;\n    }\n    while (*value && isspace((unsigned char) *value))\n        ++value;\n    if (*value != '\"') {\n        snprintf(buffer, sizeof(buffer), \"%s\", default_value);\n        return buffer;\n    }\n    ++value;\n    while (*value && *value != '\"' && out + 1U < sizeof(buffer)) {\n        if (*value == '\\\\' && value[1]) {\n            ++value;\n            if (*value == 'n')\n                buffer[out++] = '\\n';\n            else if (*value == 'r')\n                buffer[out++] = '\\r';\n            else if (*value == 't')\n                buffer[out++] = '\\t';\n            else\n                buffer[out++] = *value;\n            ++value;\n            continue;\n        }\n        buffer[out++] = *value++;\n    }\n    buffer[out] = '\\0';\n    if (*value == '\"')\n        return buffer;\n    snprintf(buffer, sizeof(buffer), \"%s\", default_value);\n    return buffer;\n}",
    "version": "1.0",
    "metadata": {
        "deltaq.doc.when_to_use": "Когда нужно получить string-настройку из плоского JSON-конфига и сразу подать её в graph flow.",
        "deltaq.doc.limitations": "Поддерживает только top-level object и обычные string scalar values с базовым unescape."
    }
}
