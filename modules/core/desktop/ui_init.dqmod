{
    "category": "desktop",
    "dependencies": [],
    "description": "Инициализация состояния UI для window1",
    "header": "",
    "id": "core.desktop.ui_init",
    "includes": [
        "\"ui/window1.h\""
    ],
    "language": "c",
    "metadata": {
        "deltaq.kind": "ui_backend_runtime",
        "deltaq.ui.backend": "sdl2",
        "deltaq.ui.backend_role": "ui_state_init",
        "deltaq.ui.layer": "backend",
        "deltaq.doc.when_to_use": "Когда нужно создать ui_state для generated desktop UI перед event loop.",
        "deltaq.doc.limitations": "Зависит от generated UI window1 и текущего SDL2 backend pipeline."
    },
    "name": "ui_init",
    "origin": "core",
    "ports": {
        "input": [
            {
                "kind": "execution",
                "name": "flow_in",
                "type": "exec"
            }
        ],
        "output": [
            {
                "kind": "execution",
                "name": "flow_out",
                "type": "exec"
            },
            {
                "name": "ui_state",
                "type": "ui_state"
            }
        ]
    },
    "source": "",
    "version": "1.0"
}
