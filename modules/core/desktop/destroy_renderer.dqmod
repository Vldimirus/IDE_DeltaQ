{
    "category": "desktop",
    "dependencies": [],
    "description": "Освобождение SDL renderer",
    "header": "",
    "id": "core.desktop.destroy_renderer",
    "includes": [
        "SDL2/SDL.h"
    ],
    "language": "c",
    "metadata": {
        "deltaq.kind": "ui_backend_runtime",
        "deltaq.ui.backend": "sdl2",
        "deltaq.ui.backend_role": "renderer_destroy",
        "deltaq.ui.layer": "backend",
        "deltaq.doc.when_to_use": "Когда завершаете desktop-flow и освобождаете SDL renderer.",
        "deltaq.doc.limitations": "Это backend-операция SDL2; после неё рендерер больше нельзя использовать."
    },
    "name": "destroy_renderer",
    "origin": "core",
    "ports": {
        "input": [
            {
                "kind": "execution",
                "name": "flow_in",
                "type": "exec"
            },
            {
                "name": "renderer",
                "type": "sdl_renderer"
            }
        ],
        "output": [
            {
                "kind": "execution",
                "name": "flow_out",
                "type": "exec"
            }
        ]
    },
    "source": "",
    "version": "1.0"
