{
    "category": "desktop",
    "dependencies": [],
    "description": "Создание SDL окна",
    "header": "",
    "id": "core.desktop.create_window",
    "includes": [
        "SDL2/SDL.h",
        "SDL2/SDL_ttf.h"
    ],
    "language": "c",
    "metadata": {
        "deltaq.kind": "ui_backend_runtime",
        "deltaq.ui.backend": "sdl2",
        "deltaq.ui.backend_role": "window_create",
        "deltaq.ui.layer": "backend",
        "deltaq.doc.when_to_use": "Когда нужно создать основное окно desktop-приложения в SDL2 pipeline.",
        "deltaq.doc.limitations": "Работает только в SDL2 backend и создаёт базовое окно без расширенных window flags."
    },
    "name": "create_window",
    "origin": "core",
    "ports": {
        "input": [
            {
                "kind": "execution",
                "name": "flow_in",
                "type": "exec"
            },
            {
                "name": "title",
                "type": "string",
                "default": "\"window1\""
            },
            {
                "name": "width",
                "type": "int",
                "default": "640"
            },
            {
                "name": "height",
                "type": "int",
                "default": "480"
            }
        ],
        "output": [
            {
                "kind": "execution",
                "name": "flow_out",
                "type": "exec"
            },
            {
                "name": "window",
                "type": "sdl_window"
            }
        ]
    },
    "source": "",
    "version": "1.0"
}
