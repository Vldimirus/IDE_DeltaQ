{
    "category": "control",
    "dependencies": [],
    "description": "Задержка в миллисекундах (execution flow)",
    "header": "",
    "id": "core.control.delay_ms",
    "includes": [
        "time.h"
    ],
    "language": "c",
    "name": "delay_ms",
    "origin": "core",
    "ports": {
        "input": [
            {
                "kind": "execution",
                "name": "flow_in",
                "type": "exec"
            },
            {
                "name": "ms",
                "type": "int"
            }
        ],
        "output": [
            {
                "kind": "execution",
                "name": "flow_out",
                "type": "exec"
            }
        ]
    },
    "source": "",
    "source_code": "void dq_delay_ms(int ms) {\n    struct timespec ts;\n    ts.tv_sec = ms / 1000;\n    ts.tv_nsec = (ms % 1000) * 1000000L;\n    nanosleep(&ts, NULL);\n}",
    "version": "1.2",
    "metadata": {
        "deltaq.doc.when_to_use": "Когда нужно сделать паузу между шагами exec-flow или в простом polling-сценарии.",
        "deltaq.doc.limitations": "Блокирует поток выполнения на заданное время и не подходит для неблокирующего UI/event-loop."
    }
}
