    "description": "Преобразование int в string",
    "header": "",
    "id": "core.conversion.int_to_string",
    "includes": [
        "stdio.h"
    ],
    "language": "c",
    "name": "int_to_string",
    "origin": "core",
    "ports": {
        "input": [
