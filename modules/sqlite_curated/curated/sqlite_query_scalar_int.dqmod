    "source": "",
    "header": "",
    "dependencies": [],
    "includes": [
        "<sqlite_deltaq_runtime.h>"
    ],
    "source_code": "/* Выполняет scalar SELECT и возвращает первую integer-колонку или fallback. */\nint dq_sqlite_query_scalar_int(const char *db_path, const char *sql, int fallback) {\n    sqlite3 *database = NULL;\n    sqlite3_stmt *statement = NULL;\n    int step_status = -1;\n    int result = fallback;\n    database = dq_sqlite_open_database(db_path);\n    if (!database)\n        return result;\n    if (dq_sqlite_prepare_statement(database, sql, &statement) != DQ_SQLITE_OK) {\n        dq_sqlite_close_database(database);\n        return result;\n    }\n    step_status = dq_sqlite_step_statement(statement);\n    if (step_status == DQ_SQLITE_ROW)\n        result = dq_sqlite_column_int_value(statement, 0);\n    dq_sqlite_finalize_statement(statement);\n    dq_sqlite_close_database(database);\n    return result;\n}",
    "metadata": {
        "deltaq.import.kind": "library_pack_module",
        "deltaq.import.pack_name": "sqlite_curated",
