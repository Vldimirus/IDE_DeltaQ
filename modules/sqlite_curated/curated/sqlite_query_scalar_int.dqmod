    "name": "sqlite_query_scalar_int",
    "version": "1.0.0",
    "language": "c",
    "description": "Curated entry: executes scalar SELECT and returns first integer value",
    "category": "sqlite_curated",
    "origin": "extension",
    "ports": {
        "input": [
