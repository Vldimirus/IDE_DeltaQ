    "source_code": "/* Открывает SQLite database по пути, выполняет SQL и закрывает handle в одном шаге. */\nint dq_sqlite_exec_path(const char *db_path, const char *sql) {\n    sqlite3 *database = dq_sqlite_open_database(db_path);\n    int status = -1;\n    if (!database)\n        return -1;\n    status = dq_sqlite_exec_sql(database, sql);\n    dq_sqlite_close_database(database);\n    return status;\n}",
