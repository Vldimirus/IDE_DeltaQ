{
    "id": "ext.mini_checksum_sdk_curated.checksum_report",
    "name": "checksum_report",
    "version": "1.0.0",
    "language": "c",
    "description": "Curated entry: seeded checksum path with runtime report",
    "category": "checksum_curated",
    "origin": "extension",
    "ports": {
        "input": [
            {
                "name": "flow_in",
                "type": "exec",
                "kind": "execution"
            },
            {
                "name": "seed",
                "type": "int",
                "default": "7"
            },
            {
                "name": "text",
                "type": "string",
                "default": "\"DeltaQ\""
            }
        ],
        "output": [
            {
                "name": "flow_out",
                "type": "exec",
                "kind": "execution"
            },
            {
                "name": "result",
                "type": "int"
            }
        ]
    },
    "source": "",
    "header": "",
    "dependencies": [],
    "includes": [
        "<stdio.h>",
        "<mini_checksum_sdk.h>"
    ],
    "source_code": "int dq_checksum_report(int seed, const char *text) {\n    mini_checksum_context *ctx = mini_checksum_init(seed);\n    if (!ctx) {\n        printf(\"INIT_FAILED\\n\");\n        return -999;\n    }\n    int checksum = mini_checksum_push_text(ctx, text);\n    printf(\"TEXT=%s\\n\", text);\n    printf(\"CHECKSUM=%d\\n\", checksum);\n    printf(\"HEX=%s\\n\", mini_checksum_hex(ctx));\n    mini_checksum_shutdown(ctx);\n    printf(\"SHUTDOWN=done\\n\");\n    return checksum;\n}",
    "metadata": {
        "deltaq.import.kind": "library_pack_module",
        "deltaq.import.pack_name": "mini_checksum_sdk_curated",
        "deltaq.import.pack_title": "Mini Checksum SDK Curated",
        "deltaq.import.language": "c",
        "deltaq.import.standard": "c17",
        "deltaq.import.original_symbol": "checksum_report",
        "deltaq.import.display_name": "Checksum Report",
        "deltaq.import.curation_role": "curated_entry",
        "deltaq.doc.when_to_use": "Когда нужен готовый imported checksum path для текста без раскрытия raw API в графе.",
        "deltaq.doc.limitations": "Печатает runtime report в stdout и рассчитан на fixture mini_checksum_sdk.",
        "deltaq.import.header_paths": [
            "mini_checksum_sdk.h"
        ],
        "deltaq.import.include_paths": [
            "${CMAKE_SOURCE_DIR}/vendor/mini_checksum_sdk/include"
        ]
    },
    "verification": {
        "compile_status": "passed",
        "test_status": "passed"
    },
    "testing": {
        "status": "passed"
    }
}
