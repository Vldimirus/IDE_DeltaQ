{
    "name": "ReusableCompositionConsole",
    "version": "1.0.0",
    "modules": [
        "dqmods/*.dqmod"
    ],
    "graphs": [
        "graphs/*.dqgraph"
    ],
    "ui_layouts": [
        "ui/*.dqui"
    ],
    "type": "console",
    "build": {
        "compiler": "auto",
        "standard": "c17",
        "output": "build/",
        "flags": []
    }
}
