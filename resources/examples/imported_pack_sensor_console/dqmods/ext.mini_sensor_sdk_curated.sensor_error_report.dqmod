{
    "id": "ext.mini_sensor_sdk_curated.sensor_error_report",
    "name": "sensor_error_report",
    "version": "1.0.0",
    "language": "c",
    "description": "Adapter over the imported SDK that demonstrates failure path and LAST_ERROR",
    "category": "sensor_curated",
    "origin": "extension",
    "ports": {
        "input": [
            {
                "name": "flow_in",
                "type": "exec",
                "kind": "execution"
            },
            {
                "name": "device_name",
                "type": "string",
                "default": "\"sensor-A\""
            },
            {
                "name": "factor",
                "type": "int",
                "default": "0"
            }
        ],
        "output": [
            {
                "name": "flow_out",
                "type": "exec",
                "kind": "execution"
            },
            {
                "name": "result",
                "type": "int"
            }
        ]
    },
    "source": "",
    "header": "",
    "dependencies": [],
    "includes": [
        "<stdio.h>",
        "<mini_sensor_sdk.h>"
    ],
    "source_code": "int dq_sensor_error_report(const char *device_name, int factor) {\n    mini_sensor_context *ctx = mini_sensor_init(device_name);\n    if (!ctx) {\n        printf(\"INIT_FAILED\\n\");\n        return -999;\n    }\n    int failed_value = mini_sensor_scale(ctx, factor);\n    printf(\"FAILED_SCALE=%d\\n\", failed_value);\n    printf(\"LAST_ERROR=%s\\n\", mini_sensor_last_error(ctx));\n    mini_sensor_shutdown(ctx);\n    printf(\"SHUTDOWN=done\\n\");\n    return failed_value;\n}",
    "metadata": {
        "deltaq.import.kind": "library_pack_module",
        "deltaq.import.pack_name": "mini_sensor_sdk_curated",
        "deltaq.import.pack_title": "Mini Sensor SDK Curated",
        "deltaq.import.language": "c",
        "deltaq.import.standard": "c17",
        "deltaq.import.original_symbol": "sensor_error_report",
        "deltaq.import.display_name": "Sensor Error Report",
        "deltaq.import.curation_role": "adapter",
        "deltaq.doc.when_to_use": "Когда нужно показать failure-path imported SDK и поведение LAST_ERROR.",
        "deltaq.doc.limitations": "Намеренно вызывает ошибку scale factor <= 0 и печатает отчёт в stdout.",
        "deltaq.import.header_paths": [
            "mini_sensor_sdk.h"
        ],
        "deltaq.import.include_paths": [
            "${CMAKE_SOURCE_DIR}/vendor/mini_sensor_sdk/include"
        ]
    },
    "verification": {
        "compile_status": "passed",
        "test_status": "passed"
    },
    "testing": {
        "status": "passed"
    }
}
