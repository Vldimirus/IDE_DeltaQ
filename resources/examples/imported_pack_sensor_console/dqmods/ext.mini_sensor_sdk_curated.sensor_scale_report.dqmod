{
    "id": "ext.mini_sensor_sdk_curated.sensor_scale_report",
    "name": "sensor_scale_report",
    "version": "1.0.0",
    "language": "c",
    "description": "Curated entry: init/read/scale/shutdown path with runtime report",
    "category": "sensor_curated",
    "origin": "extension",
    "ports": {
        "input": [
            {
                "name": "flow_in",
                "type": "exec",
                "kind": "execution"
            },
            {
                "name": "device_name",
                "type": "string",
                "default": "\"sensor-A\""
            },
            {
                "name": "factor",
                "type": "int",
                "default": "3"
            }
        ],
        "output": [
            {
                "name": "flow_out",
                "type": "exec",
                "kind": "execution"
            },
            {
                "name": "result",
                "type": "int"
            }
        ]
    },
    "source": "",
    "header": "",
    "dependencies": [],
    "includes": [
        "<stdio.h>",
        "<mini_sensor_sdk.h>"
    ],
    "source_code": "int dq_sensor_scale_report(const char *device_name, int factor) {\n    mini_sensor_context *ctx = mini_sensor_init(device_name);\n    if (!ctx) {\n        printf(\"INIT_FAILED\\n\");\n        return -999;\n    }\n    int read_value = mini_sensor_read(ctx);\n    int scaled_value = mini_sensor_scale(ctx, factor);\n    printf(\"READ=%d\\n\", read_value);\n    printf(\"SCALED=%d\\n\", scaled_value);\n    mini_sensor_shutdown(ctx);\n    printf(\"SHUTDOWN=done\\n\");\n    return scaled_value;\n}",
    "metadata": {
        "deltaq.import.kind": "library_pack_module",
        "deltaq.import.pack_name": "mini_sensor_sdk_curated",
        "deltaq.import.pack_title": "Mini Sensor SDK Curated",
        "deltaq.import.language": "c",
        "deltaq.import.standard": "c17",
        "deltaq.import.original_symbol": "sensor_scale_report",
        "deltaq.import.display_name": "Sensor Scale Report",
        "deltaq.import.curation_role": "curated_entry",
        "deltaq.doc.when_to_use": "Когда нужен готовый success-path imported SDK: init -> read -> scale -> shutdown.",
        "deltaq.doc.limitations": "Печатает runtime report в stdout и рассчитан на fixture mini_sensor_sdk.",
        "deltaq.import.header_paths": [
            "mini_sensor_sdk.h"
        ],
        "deltaq.import.include_paths": [
            "${CMAKE_SOURCE_DIR}/vendor/mini_sensor_sdk/include"
        ]
    },
    "verification": {
        "compile_status": "passed",
        "test_status": "passed"
    },
    "testing": {
        "status": "passed"
    }
}
